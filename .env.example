APP_URL=http://localhost:3000
DATABASE_PATH=./data/travel.sqlite
TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
CRON_SECRET=GENERATE_RANDOM_SECRET
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Optional dedicated OpenStreetMap geometry provider
OVERPASS_ENDPOINT=

# Email delivery: see docs/EMAIL-SETUP.md. Enable only after a real delivery test.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=
# Example sender: QuestKeeps <noreply@mail.questkeeps.ru>
EMAIL_FROM=

# Optional real support contact, e.g. an existing Telegram bot URL.
EMAIL_SUPPORT_URL=

# Telegram feedback bot: private numeric administrator ID, never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
