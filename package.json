{
  "name": "questkeeps",
  "version": "1.11.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env.local scripts/serve.mjs dev",
    "build": "next build",
    "start": "node --env-file=.env.local scripts/serve.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-env.mjs --import tsx --test tests/*.test.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "test:e2e": "playwright test",
    "format": "node scripts/format-source.mjs && prettier --write \"lib/i18n/*.json\" \"docs/**/*.md\" \"README*.md\"",
    "health": "node --env-file=.env.local --import tsx scripts/health.ts",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts",
    "test:social": "playwright test e2e/social.spec.ts --workers=1",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "format:check": "node scripts/format-source.mjs --check && prettier --check \"lib/i18n/*.json\" \"docs/**/*.md\" \"README*.md\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cities.json": "^1.1.65",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
